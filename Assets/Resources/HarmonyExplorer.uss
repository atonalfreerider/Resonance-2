.explorer { flex-grow: 1; color: rgb(231, 236, 246); font-size: 14px; }
.controls { width: 320px; max-width: 45%; flex-grow: 1; background-color: rgba(13, 19, 30, 0.96); padding: 18px; border-right-width: 1px; border-right-color: rgb(51, 65, 84); }
.eyebrow { color: rgb(133, 169, 205); font-size: 11px; letter-spacing: 3px; }
.title { font-size: 24px; -unity-font-style: bold; margin-bottom: 8px; }
.section { font-size: 12px; -unity-font-style: bold; color: rgb(154, 181, 212); margin-top: 20px; margin-bottom: 8px; }
.muted { color: rgb(164, 179, 198); white-space: normal; margin-bottom: 8px; }
.details { white-space: normal; margin-top: 8px; margin-bottom: 8px; }
.focus-hint { font-size: 11px; color: rgb(152, 207, 241); padding: 8px; background-color: rgb(27, 43, 60); border-radius: 4px; }
.orrery { flex-shrink: 0; }
.orbit-legend { font-size: 10px; color: rgb(194, 169, 118); white-space: normal; }
.section-chip, .chord-chip { font-size: 11px; padding: 4px 6px; min-height: 25px; }
.section-card { width: 120px; max-width: 48%; margin-right: 4px; flex-shrink: 0; }
.pattern-row { white-space: normal; font-size: 11px; -unity-text-align: middle-left; }
.row { flex-direction: row; flex-wrap: wrap; }
Button { background-color: rgb(34, 48, 68); border-width: 1px; border-color: rgb(66, 84, 109); border-radius: 5px; color: rgb(239, 244, 255); padding: 7px 9px; margin: 3px 4px 3px 0; }
Button:hover { background-color: rgb(55, 75, 102); }
Button:active { background-color: rgb(73, 97, 126); }
Button:focus { border-color: rgb(149, 195, 255); }
.legend { padding: 6px; margin-top: 4px; -unity-font-style: bold; }
.tonic { border-left-width: 5px; border-left-color: blue; }
.subdominant { border-left-width: 5px; border-left-color: red; }
.dominant { border-left-width: 5px; border-left-color: lime; }
TextField, DropdownField, Slider, Toggle { margin-top: 5px; margin-bottom: 5px; }
.unity-base-field { flex-direction: column; }
.unity-base-field__label { color: rgb(180, 195, 216); margin-bottom: 4px; }
.unity-base-field__input { background-color: rgb(25, 36, 53); border-width: 1px; border-color: rgb(69, 89, 118); border-radius: 4px; color: white; min-height: 26px; padding: 5px; }
.unity-base-popup-field__text { color: white; }
.unity-base-popup-field__input { flex-direction: row; align-items: center; }
.unity-base-popup-field__text { flex-grow: 1; }
.unity-text-field__input { white-space: normal; }
.unity-toggle { flex-direction: row; }
.unity-toggle__input { min-width: 18px; min-height: 18px; }
.unity-toggle__checkmark { width: 12px; height: 12px; background-color: rgb(46, 61, 79); }
.unity-toggle__input:checked > .unity-toggle__checkmark { background-color: rgb(115, 193, 255); }
.unity-base-slider__tracker { height: 3px; background-color: rgb(66, 89, 115); }
.unity-base-slider__dragger { width: 12px; height: 18px; background-color: rgb(145, 204, 255); border-radius: 3px; }
.unity-scroll-view__content-container { padding-right: 4px; flex-shrink: 0; }
.unity-scroll-view__content-container > * { flex-shrink: 0; }
.unity-scroll-view__content-viewport { flex-grow: 1; overflow: hidden; }
Label { flex-shrink: 0; }
Button { min-height: 32px; flex-shrink: 0; }
TextField, DropdownField, Slider { min-height: 54px; flex-shrink: 0; }
Toggle { min-height: 27px; flex-shrink: 0; }
.unity-scroll-view { overflow: hidden; }
.unity-base-popup-field__arrow { width: 10px; height: 10px; margin-left: 4px; background-color: rgb(116, 153, 191); }
.unity-base-text-field__input { min-height: 25px; }
.unity-base-field__input { flex-grow: 1; }
.unity-base-slider__drag-container { min-height: 22px; flex-grow: 1; }
.unity-scroller { width: 9px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-base-dropdown__container-outer { background-color: rgb(20, 30, 45); border-width: 1px; border-color: rgb(90, 122, 155); }
.unity-base-dropdown__item { min-height: 30px; padding: 5px 9px; color: rgb(235, 242, 252); }
.unity-base-dropdown__label { color: rgb(235, 242, 252); white-space: nowrap; }
.unity-base-dropdown__item:hover, .unity-base-dropdown__item:checked { background-color: rgb(46, 70, 96); }
.explorer .unity-button { background-image: none; background-color: rgb(34, 48, 68); border-width: 1px; border-color: rgb(66, 84, 109); border-radius: 5px; color: rgb(239, 244, 255); }
.explorer .unity-button:hover { background-color: rgb(55, 75, 102); }
.explorer .unity-button:active { background-color: rgb(73, 97, 126); }
.explorer .unity-base-slider__dragger { background-image: none; background-color: rgb(145, 204, 255); border-width: 0; border-radius: 3px; }
.explorer .unity-base-slider__tracker { background-image: none; background-color: rgb(66, 89, 115); border-width: 0; }
.explorer .unity-scroller__slider .unity-base-slider__dragger { background-image: none; background-color: rgb(75, 106, 134); min-width: 6px; }
.explorer .unity-foldout__content { margin-left: 0; padding-left: 0; }
.explorer .unity-foldout__toggle { margin-left: 0; }

.unity-base-dropdown__container-inner { background-image: none; background-color: rgb(20, 30, 45); }
.explorer .unity-base-popup-field__input { background-image: none; background-color: rgb(25, 36, 53); }
#rack-play-pause { background-image: none; background-color: rgb(29, 47, 66); color: white; }
.controls { min-height: 0; padding-bottom: 12px; }
.controls > .title { font-size: 21px; margin-bottom: 8px; }
.controls > .focus-hint { font-size: 10px; padding: 5px 7px; margin-bottom: 4px; }
.shared-transport { flex-shrink: 0; }
.shared-transport > Button { flex-grow: 1; }
.side-clock { font-size: 12px; color: rgb(154, 181, 212); margin-top: 0; margin-bottom: 7px; }
.side-tabs { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.side-tab-page { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.side-tab-page > .unity-scroll-view__content-viewport { min-height: 0; }
#stem-controls > .section { margin-top: 3px; }
#side-song-position { height: 55px; min-height: 55px; flex-shrink: 0; }
#side-song-position > .unity-base-field__input { height: 24px; min-height: 24px; flex-grow: 0; padding: 0; border-width: 0; background-color: transparent; }
.side-clock { flex-shrink: 0; margin-top: 4px; }
.side-tabs .unity-tab-view__header-container { width: 100%; height: 44px; flex-direction: row; flex-wrap: nowrap; flex-shrink: 0; min-height: 44px; border-bottom-width: 1px; border-bottom-color: rgb(58, 79, 101); }
.side-tabs .unity-tab__header { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 44px; padding: 4px 2px; margin: 0; background-color: transparent; border-width: 0; }
.side-tabs .unity-tab__header-label { font-size: 11px; white-space: normal; -unity-text-align: middle-center; color: rgb(165, 183, 204); margin: 0; padding: 0; }
.side-tabs .unity-tab__header:checked { background-color: rgb(22, 36, 52); }
.side-tabs .unity-tab__header:checked .unity-tab__header-label { color: rgb(224, 241, 255); }
.side-tabs .unity-tab__header-underline { background-color: transparent; height: 2px; }
.side-tabs .unity-tab__header:checked .unity-tab__header-underline { background-color: rgb(133, 195, 238); }
.side-tabs .unity-tab-view__content-viewport, .side-tabs .unity-tab-view__content-container, .side-tabs .unity-tab, .side-tabs .unity-tab__content-container { flex-grow: 1; flex-shrink: 1; min-height: 0; }
#side-transport { flex-shrink: 0; margin-bottom: 10px; }
#side-transport .focus-hint { padding: 5px 7px; font-size: 10px; }
.side-tabs .unity-tab-view__content-viewport { height: 54px; min-height: 54px; flex-grow: 0; flex-shrink: 0; }
.side-tabs .unity-tab-view__next-button, .side-tabs .unity-tab-view__previous-button { visibility: hidden; }
.side-tab-page Slider { height: 58px; min-height: 58px; }
.side-tab-page Slider > .unity-base-field__input { height: 24px; min-height: 24px; flex-grow: 0; padding: 0; border-width: 0; background-color: transparent; }
#song-director-controls {
    margin-top: 8px;
    margin-bottom: 14px;
}
#song-story-footer {
    position: absolute;
    bottom: 18px;
    right: 24px;
    padding: 12px 20px;
    background-color: rgba(9, 18, 29, 0.84);
    border-radius: 12px;
    border-top-width: 1px;
    border-top-color: rgba(130, 190, 240, 0.4);
}
#song-story-caption {
    white-space: normal;
    font-size: 17px;
    color: rgb(235, 243, 250);
    -unity-text-align: middle-center;
}
